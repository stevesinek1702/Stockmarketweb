# Docker Compose env file (root project)
# Copy file này thành .env rồi điền giá trị thật.
# KHÔNG commit .env (đã .gitignore).
#
# Lưu ý: đây là env cho docker-compose ở root, KHÁC với server/.env
# (server/.env chỉ dùng khi chạy dev local không qua Docker).

# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=vnstock
POSTGRES_PASSWORD=change-to-strong-password
POSTGRES_DB=vnstock

# ── Auth ──────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change-to-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-strong-password
ADMIN_EMAIL=

# ── FireAnt cookie sync (Playwright autologin) ────────────
FIREANT_EMAIL=
FIREANT_PASSWORD=
APPS_SCRIPT_URL=
COOKIE_TTL_HOURS=6
COOKIE_SYNC_HOURS=5

# ── Google Sheet sync (lịch sử lực cầu ngành) ────────────
GSHEET_SYNC_URL=
GSHEET_SYNC_TOKEN=

# ── AI Market Report (tab 🤖 Báo Cáo AI) ────────────────
# Cần ít nhất 1 key. DeepSeek primary, Gemini fallback.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
TOKENROUTER_API_KEY=
# OpenRouter (Nous Hermes / Nemotron 120B free) — Trading Agent + /ai Telegram
OPENROUTER_API_KEY=

# ── Telegram Bot (thông báo tín hiệu + chat commands) ─────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Broker (Subsystem #5 — auto-trade) ───────────────────
# Mặc định PAPER (mô phỏng, an toàn). Live cần account thật + explicit mode.
# paper=simulate (default) | ssi=SSI FastConnect (live) | dnse=DNSE Lightspeed (live)
BROKER_MODE=paper

# SSI FastConnect (https://www.ssi.com.vn/en/individual-customer/fast-connect-api)
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
SSI_ACCOUNT=

# DNSE Lightspeed
DNSE_TOKEN=
DNSE_ACCOUNT=
DNSE_API_URL=https://api.dnse.com.vn

# ── Risk mgmt (Subsystem #4) ──────────────────────────────
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=25
MAX_OPEN_POSITIONS=10
MAX_SECTOR_PCT=40
ATR_MULTIPLIER=2
TARGET_RR=2

# ── Auto-exec loop (Subsystem #6) ─────────────────────────
# Mặc định DISABLED (kill-switch off). Bật = '1'. CHỈ bật sau khi test paper OK.
AUTOEXEC_ENABLED=0
AUTOEXEC_INTERVAL_MS=300000
MAX_DAILY_LOSS_PCT=7
