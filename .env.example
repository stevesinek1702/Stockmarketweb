# Docker Compose env file (root project)
# Copy file này thành .env rồi điền giá trị thật.
# KHÔNG commit .env (đã .gitignore).
#
# Lưu ý: đây là env cho docker-compose ở root, KHÁC với server/.env
# (server/.env chỉ dùng khi chạy dev local không qua Docker).

# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=vnstock
POSTGRES_PASSWORD=change-to-strong-password
POSTGRES_DB=vnstock

# ── Auth ──────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change-to-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-strong-password
ADMIN_EMAIL=

# ── FireAnt cookie sync (Playwright autologin) ────────────
FIREANT_EMAIL=
FIREANT_PASSWORD=
APPS_SCRIPT_URL=
COOKIE_TTL_HOURS=6
COOKIE_SYNC_HOURS=5

# ── Google Sheet sync (lịch sử lực cầu ngành) ────────────
GSHEET_SYNC_URL=
GSHEET_SYNC_TOKEN=
