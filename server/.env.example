# Sao chép file này thành "server/.env" rồi điền giá trị thật.
# KHÔNG commit server/.env lên Git (đã được .gitignore loại trừ).

# Cổng chạy server (mặc định 3000)
PORT=3000

# (Tùy chọn) Đồng bộ lịch sử lực cầu ngành lên Google Sheet qua Apps Script
# Lấy URL khi Deploy Web App từ server/gsheet-apps-script.gs
GSHEET_SYNC_URL=
GSHEET_SYNC_TOKEN=

# Phase 1-2: Cache layer (Redis hot + Postgres cold)
# Dev local: dùng docker compose up -d
DATABASE_URL=postgres://vnstock:vnstock_dev@localhost:5432/vnstock
REDIS_URL=redis://localhost:6379

# Phase 3: Auth
# JWT_SECRET: chuỗi ngẫu nhiên dài (dùng `openssl rand -hex 32` để generate)
JWT_SECRET=change-me-to-a-long-random-string
# Admin bootstrap (chạy: npm run seed-admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# AI Market Report (tab 🤖 Báo Cáo AI) — DeepSeek primary, Gemini fallback
# Cần ít nhất 1 key để tab báo cáo AI hoạt động.
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# TokenRouter (GLM-5.2 free): https://tokenrouter.com
TOKENROUTER_API_KEY=
# OpenRouter (Nous Hermes 3 405B free): https://openrouter.ai
OPENROUTER_API_KEY=

# Telegram Bot — thông báo tín hiệu + chat commands
# Tạo bot: chat @BotFather → /newbot → copy token
# Lấy Chat ID: thêm bot vào group, hoặc chat với bot rồi vào https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
